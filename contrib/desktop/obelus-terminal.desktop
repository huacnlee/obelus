[Desktop Entry]
Type=Application
Name=Obelus
# `Development` and not `TextEditor`: the category is only where a launcher
# files it, and that is among the tools for code.
Categories=Development;ConsoleOnly;
GenericName=Code Editor
Comment=A code editor in a terminal, with the agent built in.
Exec=ob %F
Icon=obelus
# The launcher picks the terminal: `xdg-terminal-exec` where it is there,
# which is how this lands in the terminal the reader chose -- and on
# omarchy, in the one omarchy is set up with -- rather than in one named
# here.
Terminal=true
MimeType=text/plain;inode/directory;
